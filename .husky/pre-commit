# Node Discovery: Staff-grade Resilience
if ! command -v node >/dev/null 2>&1; then
  export PATH="$PATH:/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin"
  [ -f "$HOME/.nvm/nvm.sh" ] && . "$HOME/.nvm/nvm.sh" && nvm use --silent >/dev/null 2>&1
  [ -f "$HOME/.asdf/asdf.sh" ] && . "$HOME/.asdf/asdf.sh" >/dev/null 2>&1
fi

if ! command -v node >/dev/null 2>&1; then
  echo "❌ Error: 'node' not found in PATH. Husky hooks failed."
  exit 1
fi

# why: lint-staged lints and formats what is being committed, and pre-push runs
# the suite. Running the whole lint and the whole suite here as well doubled the
# cost of every commit without catching anything the other two miss.
npx lint-staged

# why: lint-staged reformats files under src/assets/ after the mirror was built,
# which leaves .ai/kit/ holding the pre-format text. The kit is not versioned, so
# nothing here needs staging; without the rebuild the next `audit:` reports a
# drift the developer did not cause. The guard exists because `init` also owns
# .gitignore, which this repository does track: a change there mid-commit would
# land outside the staged set, so the hook stops instead of hiding it.
GITIGNORE_BEFORE=$(git hash-object .gitignore)
npm run dev -- init --quick >/dev/null
GITIGNORE_AFTER=$(git hash-object .gitignore)

if [ "$GITIGNORE_BEFORE" != "$GITIGNORE_AFTER" ]; then
  echo "❌ init rewrote .gitignore during the commit. Stage it and commit again."
  exit 1
fi
