{
  "name": "spec-driven-guide",
  "version": "8.0.0",
  "description": "Spec-driven governance for AI coding agents. A CLI that installs AGENTS.md and on-demand skills so Claude Code, Cursor, Copilot, Codex, Gemini and Windsurf follow one protocol: spec, plan, code, test, end.",
  "type": "module",
  "main": "./src/engine/bin/index.mjs",
  "bin": {
    "spec-driven-guide": "src/engine/bin/index.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node src/engine/bin/index.mjs",
    "build": "node src/engine/bin/init/build-bundle.mjs",
    "review": "node src/engine/bin/maintenance/review-bundle.mjs",
    "bump": "node scripts/bump.mjs",
    "clear": "node src/engine/bin/maintenance/clear-bundle.mjs",
    "prune": "node src/engine/bin/lifecycle/prune-backlog.mjs",
    "test": "node --test \"src/engine/**/*.test.mjs\" \"src/assets/tooling/**/*.test.mjs\" \"scripts/**/*.test.mjs\"",
    "test:watch": "node --test --watch \"src/engine/**/*.test.mjs\" \"src/assets/tooling/**/*.test.mjs\" \"scripts/**/*.test.mjs\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "gate": "npm audit --audit-level=moderate && npm run lint && npm test && npm run dev -- audit",
    "dogfood": "npm run dev -- init --quick && npm run gate",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "keywords": [
    "ai",
    "agents",
    "agents-md",
    "spec-driven-development",
    "spec-driven",
    "ai-governance",
    "ai-coding-assistant",
    "claude",
    "claude-code",
    "cursor",
    "windsurf",
    "copilot",
    "codex",
    "gemini",
    "agent-rules",
    "ai-rules",
    "coding-standards",
    "prompt-engineering",
    "llm",
    "specs",
    "rules",
    "architecture",
    "markdown",
    "cli",
    "developer-tools"
  ],
  "author": "thiagocajadev",
  "license": "ISC",
  "files": [
    "src/engine/",
    "src/assets/",
    "!src/engine/**/*.test.mjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thiagocajadev/spec-driven-guide.git"
  },
  "bugs": {
    "url": "https://github.com/thiagocajadev/spec-driven-guide/issues"
  },
  "homepage": "https://specdrivenguide.org",
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "dedent": "^1.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6"
  },
  "lint-staged": {
    "**/*.mjs": "eslint --fix",
    "**/*.{json,md}": "prettier --write"
  }
}
